# Database connection strings (PostgreSQL)
# Admin connection string: used only for migrations (Alembic) and seeding
DATABASE_URL=postgresql://chordly_admin:chordly_local_dev_password@localhost:5432/chordly

# Read-only connection string: used by the FastAPI web application
DATABASE_URL_READONLY=postgresql://chordly_reader:chordly_local_reader_password@localhost:5432/chordly

# Application configuration
ENVIRONMENT=development
DEBUG=false
ALLOWED_ORIGINS=http://localhost:3000

# Rate limiting
RATE_LIMIT_PER_MINUTE=60
