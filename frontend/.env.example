# Optional remote FastAPI URL. Leave unset (or localhost) to use bundled song data.
# NEXT_PUBLIC_API_URL=https://your-backend.example.com

# Never put API keys, tokens, passwords or credentials in NEXT_PUBLIC_* variables.
# Production audio uses the same-origin /api/audio endpoint with no API key.
# These flags select the separate LOCAL development server only.
# NEXT_PUBLIC_ENABLE_AUDIO_ML=true
# NEXT_PUBLIC_ML_API_URL=http://127.0.0.1:8100
